# sponsors.agnteng.com: builds apps/site and runs apps/site/sponsors.mjs over it
# (docs/adr/0029). It stays in apps/branding because the sponsors service's build
# points here. Build context: the repository root.
FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/site/package.json apps/site/
COPY apps/branding/package.json apps/branding/
COPY packages/brand/package.json packages/brand/
RUN pnpm install --frozen-lockfile --filter site...
COPY . .
RUN pnpm --filter site build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /repo/apps/site/sponsors.mjs ./
COPY --from=build /repo/apps/site/dist ./dist
ENV NODE_ENV=production
# Port 80, which the service's existing port mapping expects.
ENV PORT=80
EXPOSE 80
CMD ["node", "sponsors.mjs"]
