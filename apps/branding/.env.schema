# branding.agnteng.com's environment. Its secrets resolve from the agnteng project vault
# in 1Password, as on every app of the platform (org ADR 0025, docs/adr/0027): the service
# carries OP_TOKEN, and varlock fetches the rest when the server starts, so no secret is
# written into an image layer. LUMA_API_KEY still comes from the deploy's .env at build
# (docs/adr/0002).
#
# @defaultSensitive=true @defaultRequired=false
# @currentEnv=$APP_ENV
# @plugin(@varlock/1password-plugin@2.0.4)
# @initOp(token=$OP_TOKEN, allowAppAuth=false, cacheTtl=5m, allowMissing=true)
# ---

# @sensitive=false @type=enum(development, preview, production, test)
APP_ENV=development

# 1Password service-account token, read-only on the agnteng project vault. Set on the
# branding service in Dokploy. Locally: `OP_TOKEN=varlock(prompt)` in apps/branding/.env.local,
# then `varlock load` in your own terminal.
# @type=opServiceAccountToken @sensitive @internal
OP_TOKEN=

# The sponsor form's webhook to Grok Bot (docs/adr/0027). An item that isn't there leaves
# its variable empty: the form then says it can't send, and the live check fails.
GROKBOT_WEBHOOK_URL=op(op://sa-project-agnteng/grokbot-webhook-url/credential)
GROKBOT_WEBHOOK_HEADER=op(op://sa-project-agnteng/grokbot-webhook-header/credential)
GROKBOT_WEBHOOK_KEY=op(op://sa-project-agnteng/grokbot-webhook-key/credential)
