# branding.agnteng.com's secrets, resolved from the project's 1Password vault by start.sh
# when the container starts (docs/adr/0027, org ADR 0025). Locally: see the README.
#
# @defaultSensitive=true @defaultRequired=false
# @currentEnv=$APP_ENV
# @plugin(@varlock/1password-plugin@2.0.4)
# @initOp(token=$OP_TOKEN, allowAppAuth=false, cacheTtl=5m, allowMissing=true)
# ---

# @sensitive=false @type=enum(development, preview, production, test)
APP_ENV=development

# 1Password service-account token, read-only on the project vault; set on the service.
# @type=opServiceAccountToken @sensitive @internal
OP_TOKEN=

# The forms' webhook to Grok Bot (sponsor and speaker). A missing item leaves its variable empty.
# @type=url
GROKBOT_WEBHOOK_URL=op(op://sa-project-agnteng/grokbot-webhook-url/credential)
GROKBOT_WEBHOOK_HEADER=op(op://sa-project-agnteng/grokbot-webhook-header/credential)
GROKBOT_WEBHOOK_KEY=op(op://sa-project-agnteng/grokbot-webhook-key/credential)
