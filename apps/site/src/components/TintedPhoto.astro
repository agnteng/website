---
// A photo in the site's one tint, or with a light wash of the brand colour given as `tint`.
import { Image } from 'astro:assets';
interface Props {
  src: ImageMetadata | string;
  alt: string;
  sizes?: string;
  class?: string;
  zoom?: boolean; // grow a little when the enclosing .group is hovered
  tint?: string;
}
const { src, alt, sizes = '33vw', class: cls, zoom = false, tint } = Astro.props;
const img = ['photo-tint absolute inset-0 size-full object-cover', zoom && 'transition duration-500 group-hover:scale-[1.03]'];
---
<div class:list={['relative overflow-hidden bg-deep-navy', cls]}>
  {typeof src === 'string'
    ? <img src={src} alt={alt} loading="lazy" class:list={img} />
    : <Image src={src} alt={alt} widths={[480, 960]} sizes={sizes} loading="lazy" class:list={img} />}
  <div aria-hidden="true" class:list={[tint ? 'photo-colour-wash' : 'photo-tint-wash', 'pointer-events-none absolute inset-0']} style={tint && `--tint: ${tint}`}></div>
</div>
