---
// A past meetup: its cover photo, name and date, linking to its page.
import TintedPhoto from './TintedPhoto.astro';
import Animation from '@agnteng/brand/components/Animation.tsx';
import { coverAt, shortDate, eventSlug, eventName, type Event } from '../lib/data';
import { TINTS } from '../lib/tints';
interface Props { event: Event; index: number }
const { event: e, index: i } = Astro.props;
const cover = coverAt(e);
---
<a href={`/events/${eventSlug(e)}`} class="group block">
  {cover
    ? <TintedPhoto src={cover.img} alt={cover.alt} sizes="(min-width: 1024px) 16vw, (min-width: 640px) 33vw, 50vw" zoom tint={TINTS[i % TINTS.length]} class="aspect-[4/3] rounded-2xl" />
    : <div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-deep-navy"><Animation client:visible paused color="#1E2BE6" edge="#B5A6FF" cell={8} density={0.6} fade="radial" style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} /></div>}
  <p class="mt-3 font-sans font-bold group-hover:text-electric-blue">{eventName(e)}</p>
  <p class="mt-0.5 text-sm text-panel-navy/60">{shortDate(e.date)}</p>
</a>
