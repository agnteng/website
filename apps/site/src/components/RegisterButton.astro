---
// The one Register button, the same everywhere: "Register", a white pill on the blue or navy
// it sits on. `event` is the meetup (the next one by default); on the next meetup it carries
// js-register, which SiteNav's script turns into "Follow on Luma" once that meetup has
// started. `followLuma` is that state from the start; `secondary` is the outline look,
// beside another button; `size="sm"` is the header's.
import Button from '@agnteng/brand/components/Button.astro';
import { nextEvent, links, type Event } from '../lib/data';
interface Props { event?: Event; size?: 'md' | 'sm'; followLuma?: boolean; secondary?: boolean; class?: string }
const { event = nextEvent, size = 'md', followLuma = false, secondary = false, class: cls } = Astro.props;
const live = !followLuma && event;
const href = live ? event.luma?.url ?? links.luma : links.luma;
---
<Button variant={secondary ? 'inverse-outline' : 'inverse'} size={size} href={href} class={[live && event === nextEvent && 'js-register', cls].filter(Boolean).join(' ')}>{live ? 'Register' : 'Follow on Luma'}</Button>
