---
// The invitation at the end of a talk: the next meetup, when it is, and Register.
import SubHeading from './SubHeading.astro';
import EventDate from './EventDate.astro';
import RegisterButton from './RegisterButton.astro';
import { nextEvent, eventSlug, eventName, pitch, inCity } from '../lib/data';
---
{nextEvent && (
  <section class="py-16">
    <div class="flex flex-col gap-6 rounded-2xl bg-electric-blue p-8 text-white md:flex-row md:items-center md:justify-between md:p-10">
      <div>
        <SubHeading as="h2"><a href={`/events/${eventSlug(nextEvent)}`} class="hover:underline">Next meetup: {eventName(nextEvent)}</a></SubHeading>
        <EventDate date={nextEvent.date} event={nextEvent} variant="hero" class="mt-3" />
        <p class="mt-4 max-w-[52ch] leading-relaxed text-white/90">{pitch} {inCity(nextEvent.city)}</p>
      </div>
      <RegisterButton event={nextEvent} on="blue" class="shrink-0 self-start md:self-center" />
    </div>
  </section>
)}
