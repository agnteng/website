---
// Shares of one whole as one solid bar, each label under the start of its part, as on the
// sponsor deck. On a phone the labels become a legend. The bar wipes in from the left once
// it is in view; without script or motion it is simply there.
interface Segment { label: string; share: number; color: string }
interface Props { segments: Segment[]; class?: string }
const { segments, class: cls } = Astro.props;
---
<div class={cls}>
  <div data-share-bar class="flex h-12 w-full overflow-hidden rounded-lg md:h-16" aria-hidden="true">
    {segments.map((s) => <div class="h-full" style={`width:${s.share}%; background:${s.color}`}></div>)}
  </div>
  <!-- Desktop: each share under its own part. -->
  <ul class="mt-6 flex max-md:hidden">
    {segments.map((s) => (
      <li class="min-w-0 pr-4" style={`width:${s.share}%`}>
        <p class="font-sans text-5xl font-extrabold leading-none tracking-tight tabular-nums">{s.share}%</p>
        <p class="mt-2.5 text-soft-white/70">{s.label}</p>
      </li>
    ))}
  </ul>
  <!-- Phone: a legend, one row each. -->
  <ul class="mt-6 divide-y divide-white/10 border-y border-white/10 md:hidden">
    {segments.map((s) => (
      <li class="flex items-center gap-3 py-3">
        <span class="size-3 shrink-0 rounded-sm" style={`background:${s.color}`}></span>
        <span class="flex-1 text-soft-white/80">{s.label}</span>
        <span class="font-sans text-2xl font-extrabold tabular-nums">{s.share}%</span>
      </li>
    ))}
  </ul>
</div>
<style>
  [data-share-bar][data-wipe='pending'] { clip-path: inset(0 100% 0 0); }
  [data-share-bar][data-wipe='in'] { clip-path: inset(0); transition: clip-path 1.1s cubic-bezier(0.16, 1, 0.3, 1); }
</style>
<script>
  // Hidden only once the script runs and the bar is still below the fold, so a page
  // without script, or without motion, shows it whole. The observer watches the bar's
  // wrapper: a fully clipped element never counts as in view.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const bar of document.querySelectorAll<HTMLElement>('[data-share-bar]')) {
      if (bar.getBoundingClientRect().top < innerHeight) continue;
      bar.dataset.wipe = 'pending';
      const seen = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        seen.disconnect();
        requestAnimationFrame(() => (bar.dataset.wipe = 'in'));
      }, { threshold: 0.5 });
      seen.observe(bar.parentElement!);
    }
  }
</script>
