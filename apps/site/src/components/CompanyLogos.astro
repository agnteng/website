---
// Where the community works. Each logo is drawn once, as a <symbol> every copy
// of the strip uses. The label sits on the strip's line: the logos blur and
// fade into the white behind it as they pass under it.
import Marquee from '@agnteng/brand/components/Marquee.astro';
import { companies } from '../lib/companies';
import { lineLabel } from '../lib/type';
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<div class={cls}>
  <div class="relative overflow-x-clip">
    <div class="pointer-events-none absolute inset-0 z-10 mx-auto flex max-w-7xl px-4 motion-reduce:static motion-reduce:mb-6 md:px-8 md:motion-reduce:mb-8">
      <div class="veil relative flex items-center pr-4 [--fade:3.5rem] md:pr-8 md:[--fade:8rem]">
        <span class="haze"><span></span><span></span><span></span></span>
        <p class:list={[lineLabel, 'relative z-20 max-w-[6.5rem] text-panel-navy motion-reduce:max-w-none sm:max-w-none']}>Community members from</p>
      </div>
    </div>
    <svg aria-hidden="true" class="absolute size-0 overflow-hidden">
      {companies.map((c) => <symbol id={`company-${c.id}`} viewBox={c.viewBox} set:html={c.paths} />)}
    </svg>
    <!-- Same speed on every screen: a phone's strip is shorter. -->
    <Marquee tone="none" class="text-panel-navy [--ae-marquee-duration:45s] md:[--ae-marquee-duration:75s]">
      <ul role="list" class="flex items-center gap-x-10 pr-10 motion-reduce:mx-auto motion-reduce:w-full motion-reduce:max-w-7xl motion-reduce:flex-wrap motion-reduce:gap-y-6 motion-reduce:px-4 md:gap-x-20 md:pr-20 md:motion-reduce:gap-y-8 md:motion-reduce:px-8">
        {companies.map((c) => (
          <li class="flex shrink-0 items-center">
            <svg role="img" aria-label={c.name} viewBox={c.viewBox} class="h-[calc(var(--size)*2rem)] w-auto fill-current opacity-60 md:h-[calc(var(--size)*3rem)]" style={`--size: ${c.size}; aspect-ratio: ${c.width} / 100`}>
              <use href={`#company-${c.id}`} />
            </svg>
          </li>
        ))}
      </ul>
    </Marquee>
  </div>
</div>

<style>
  /* White up to the label, easing out over --fade above a progressive blur
     (stacked backdrop blurs, each masked to its band); assumes a white section. */
  .veil::after {
    content: '';
    position: absolute;
    inset-block: 0;
    left: -100vw;
    right: calc(-1 * var(--fade));
    z-index: 10;
    background: linear-gradient(to right,
      var(--color-white) calc(100% - var(--fade)),
      rgb(255 255 255 / 0.9) calc(100% - var(--fade) * 0.8),
      rgb(255 255 255 / 0.65) calc(100% - var(--fade) * 0.55),
      rgb(255 255 255 / 0.3) calc(100% - var(--fade) * 0.3),
      rgb(255 255 255 / 0.08) calc(100% - var(--fade) * 0.1),
      transparent);
  }
  .haze {
    position: absolute;
    inset-block: 0;
    left: 100%;
    width: var(--fade);
  }
  .haze > span { position: absolute; inset: 0; }
  .haze > span:nth-child(1) {
    backdrop-filter: blur(1px);
    mask: linear-gradient(to left, transparent, #000 40%);
  }
  .haze > span:nth-child(2) {
    backdrop-filter: blur(3px);
    mask: linear-gradient(to left, transparent 30%, #000 70%);
  }
  .haze > span:nth-child(3) {
    backdrop-filter: blur(6px);
    mask: linear-gradient(to left, transparent 60%, #000);
  }
  /* Contrast themes drop gradients: keep the label on solid ground. */
  @media (forced-colors: active) {
    .veil::after { background: Canvas; }
  }
</style>
