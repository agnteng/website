---
// The home page's hero: an electric-blue block. Photos of the meetups take its blue and
// break up into it cell by cell. The page includes <Tone /> for the photos' colour.
import { Image } from 'astro:assets';
import HeroCells from './HeroCells.astro';
import SiteNav from './SiteNav.astro';
import PageTitle from './PageTitle.astro';
import NextMeetup from './NextMeetup.astro';
import { nextEvent, galleryPhoto, pitchIn } from '../lib/data';

// Talks, questions and the audience take turns. `head` is where the subject's head is in
// the photo (fractions of its width and height); every head goes to the same point of
// the frame, whatever the frame's shape. `zoom` enlarges past that.
const shots = [
  { ...galleryPhoto('2026-08-26', '18.jpg'), head: [0.33, 0.38], zoom: 1 },
  { ...galleryPhoto('2026-05-27', '06.jpg'), head: [0.63, 0.41], zoom: 1.1 },
  { ...galleryPhoto('2026-08-26', '04.jpg'), head: [0.47, 0.56], zoom: 1 },
  { ...galleryPhoto('2026-11-11', '25.jpg'), head: [0.4, 0.48], zoom: 1 },
  { ...galleryPhoto('2026-08-26', '10.jpg'), head: [0.57, 0.5], zoom: 1.15 },
  { ...galleryPhoto('2026-11-11', '20.jpg'), head: [0.37, 0.47], zoom: 1 },
];
// Where a head goes in the frame, and how far the photo may stop short of the frame's
// leading edge: no more than <HeroCells> keeps whole. Beside the copy on desktop, the frame's
// left side dissolves; under the copy on a phone, its top does.
const DESK = { at: [0.67, 0.36], clear: [0.2, 0] };
const PHONE = { at: [0.5, 0.5], clear: [0, 0] };
const place = (p: (typeof shots)[number], { at: [tx, ty], clear: [cx, cy] }: typeof DESK) => {
  const [fx, fy] = p.head, a = p.img.width / p.img.height;
  // The photo's width is the larger of two candidates: enough of the frame's width, and
  // enough of its height, to cover the frame with the head on the point.
  const w = Math.max(1, (tx - cx) / fx, (1 - tx) / (1 - fx)) * p.zoom * 100;
  const h = Math.max(1, (ty - cy) / fy, (1 - ty) / (1 - fy)) * a * p.zoom * 100;
  const wide = `max(${w.toFixed(1)}cqw, ${h.toFixed(1)}cqh)`;
  return [wide, `calc(${tx * 100}cqw - ${fx} * ${wide})`, `calc(${ty * 100}cqh - ${(fy / a).toFixed(4)} * ${wide})`];
};
const photos = shots.map((p, i) => {
  const [w, l, t] = place(p, PHONE), [wd, ld, td] = place(p, DESK);
  return { img: p.img, style: `--n:${i}; aspect-ratio:${p.img.width}/${p.img.height}; --w:${w}; --l:${l}; --t:${t}; --wd:${wd}; --ld:${ld}; --td:${td}` };
});
---
<section class="relative isolate overflow-hidden bg-electric-blue text-white">
  <SiteNav onHero />
  <!-- The skip link lands here. -->
  <div id="main" class="relative z-10 mx-auto grid max-w-7xl items-center px-4 pt-14 pb-10 md:grid-cols-12 md:px-8 md:pt-20 md:pb-28">
    <div class="md:col-span-6">
      <PageTitle rise style="--i:0">A community of founders and engineers building with agents.</PageTitle>
      <p class="rise mt-7 max-w-[44ch] text-lg font-medium leading-relaxed text-white/90" style="--i:1">{pitchIn(nextEvent?.city ?? 'Lisbon')}</p>
      <NextMeetup event={nextEvent} class="rise mt-10" style="--i:2" />
    </div>
  </div>

  <!-- The photos' frame: under the copy on a phone, the block's right side on desktop.
       Photos and cells appear together, once the cells have painted. -->
  <div class="dither-stage relative isolate h-96 w-full overflow-hidden [container-type:size] md:absolute md:inset-y-0 md:right-0 md:h-auto md:w-[64%]" aria-hidden="true">
    <!-- `sizes` is the photos' own width: they are larger than their frame. -->
    {photos.map((p, i) => (
      <Image src={p.img} alt="" widths={[960, 1280, 1600]} quality={60} sizes="(min-width: 768px) 110vw, 150vw" loading={i ? 'lazy' : 'eager'} fetchpriority={i ? 'auto' : 'high'} class="hero-turn absolute left-(--l) top-(--t) h-auto w-(--w) max-w-none [filter:url(#blue-tone)] md:left-(--ld) md:top-(--td) md:w-(--wd)" style={p.style} />
    ))}
    <HeroCells seed={2027} />
  </div>
</section>
<style>
  /* Six seconds each. A photo fades in over the one before, which stays whole until the
     new one covers it. Without motion, the first photo stays. */
  .hero-turn { opacity: 0; }
  .hero-turn:first-child { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-turn { animation: hero-turn 36s linear infinite; animation-delay: calc(var(--n) * 6s - 1.08s); }
    @keyframes hero-turn {
      0% { opacity: 0; z-index: 1; }
      3% { opacity: 1; z-index: 1; }
      3.01% { z-index: 0; }
      19.67% { opacity: 1; }
      19.68%, 100% { opacity: 0; }
    }
  }
</style>
