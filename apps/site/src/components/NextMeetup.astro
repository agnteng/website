---
// The next meetup in a blue hero: Register, its name and when it starts. Once it has
// started, SiteNav's script shows the second block instead until the site is rebuilt; only
// for the site's next meetup, the one the script watches.
import RegisterButton from './RegisterButton.astro';
import EventDate from './EventDate.astro';
import { nextEvent, eventSlug, eventName, type Event } from '../lib/data';
interface Props { event?: Event; class?: string; style?: string }
const { event, class: cls, style } = Astro.props;
---
{event && (
  <div class={cls} style={style}>
    <div data-next-event={event === nextEvent ? '' : undefined} class="flex flex-wrap items-center gap-x-6 gap-y-4">
      <RegisterButton event={event} on="blue" />
      <div class="leading-tight">
        <a href={`/events/${eventSlug(event)}`} class="block text-lg font-extrabold hover:underline">Next meetup: {eventName(event)}</a>
        <EventDate date={event.date} event={event} variant="hero" class="mt-1.5" />
      </div>
    </div>
    <div data-next-event-after hidden class="flex flex-wrap items-center gap-x-6 gap-y-4">
      <RegisterButton on="blue" followLuma />
      <p class="text-lg font-extrabold">The next date is on its way.</p>
    </div>
  </div>
)}
