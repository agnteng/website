---
// The brand TalkCard, with the talk's own video still when there is one and
// the dither field as its illustration when there isn't.
import { Image } from 'astro:assets';
import Animation from '@agnteng/brand/components/Animation.tsx';
import Avatar from '@agnteng/brand/components/Avatar.astro';
import EventDate from './EventDate.astro';
import { still as stillOf, thumbnail, avatarOf, eventName, type Talk } from '../lib/data';
// `summary` adds the talk's one-sentence summary under its title. `showEvent` puts the
// meetup and its date above the title; a page that is the meetup's own turns it off.
// `as` is the title's heading level: h2 where the tiles are the page's only list.
interface Props { talk: Talk; index?: number; summary?: boolean; showEvent?: boolean; as?: 'h2' | 'h3' }
const { talk, index = 0, summary = false, showEvent = true, as: Heading = 'h3' } = Astro.props;
const local = stillOf(talk);
const still = thumbnail(talk);
// Vary the dither's fade so a row of talks without video reads as distinct textures.
const fade = (['right', 'left', 'radial', 'up', 'down'] as const)[index % 5];
---
<a href={`/talks/${talk.id}`} class="group flex h-full flex-col overflow-hidden rounded-2xl border border-panel-navy/[0.08] bg-white transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-electric-blue/10">
  <div class="relative aspect-video overflow-hidden bg-deep-navy">
    {local
      ? <Image src={local} alt="" widths={[480, 960]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 90vw" class="size-full object-cover" loading="lazy" />
      : still
      ? <img src={still} alt="" class="size-full object-cover" loading="lazy" />
      : <Animation client:visible color="#1E2BE6" edge="#B5A6FF" cell={9} density={0.6} fade={fade} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />}
  </div>
  <div class="flex flex-1 flex-col p-5">
    {showEvent && <EventDate date={talk.event.date} variant="eyebrow" class="mb-2">{eventName(talk.event)}</EventDate>}
    <Heading class="font-sans text-xl font-extrabold leading-snug tracking-tight text-panel-navy">{talk.title}</Heading>
    {summary && <p class="mt-3 text-sm leading-relaxed text-panel-navy/75">{talk.summary}</p>}
    <!-- Filled by the talks search: where the words were said, linked to that moment. -->
    <p data-snippet hidden class="search-excerpt mt-3 line-clamp-3 text-sm leading-relaxed text-panel-navy/75"></p>
    <p class="mt-auto flex items-center gap-2.5 pt-5 font-sans text-sm text-panel-navy/60">
      <span aria-hidden="true"><Avatar name={talk.person.name} src={await avatarOf(talk.person.photo)} size={28} /></span>{talk.person.name}
    </p>
  </div>
</a>
