---
// The floating, sticky nav. `onHero`: frosted glass over a page's blue hero, navy once the page
// moves (and without JavaScript); that hero comes right after the nav and takes `under-nav`
// (site.css) to run up beneath it.
import RegisterButton from './RegisterButton.astro';
import Button from '@agnteng/brand/components/Button.astro';
import Icon from '@agnteng/brand/components/Icon.astro';
import { nextEvent, links } from '../lib/data';
interface Props { onHero?: boolean }
const { onHero = false } = Astro.props;
const starts = nextEvent && (nextEvent.luma?.startAt ?? `${nextEvent.date}T23:59:00Z`);
const luma = links.luma;
const here = Astro.url.pathname.replace(/\/$/, '');
const sections = [
  { label: 'Talks', href: '/talks' },
  { label: 'Speakers', href: '/speakers' },
  { label: 'Events', href: '/events' },
  { label: 'Sponsor', href: '/sponsor' },
];
const speak = { label: 'Apply to speak', href: '/speak' };
---
<header data-sticky-nav class="group pointer-events-none sticky top-3 z-50 mx-auto max-w-7xl px-4 text-white md:top-4 md:px-8">
  <div class:list={['pointer-events-auto relative grid h-14 grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 rounded-full border pl-4 pr-2 shadow-[0_12px_32px_-12px_rgb(5_7_30/0.35)] backdrop-blur-xl transition-colors duration-300 md:grid-cols-[1fr_minmax(0,22rem)_1fr] md:gap-5', onHero ? 'border-white/20 bg-white/12 group-data-[scrolled]:border-white/10 group-data-[scrolled]:bg-deep-navy/85 [@media(scripting:none)]:border-white/10 [@media(scripting:none)]:bg-deep-navy/85' : 'border-white/10 bg-deep-navy/85']}>
    <div class="flex items-center gap-7 justify-self-start">
      <a href="/" class="shrink-0"><img src="/assets/logo/ae-mark-white.svg" width="187" height="160" alt="Agentic Engineering" class="h-7 w-auto" /></a>
      <nav aria-label="Sections" class="hidden items-center gap-6 xl:flex">
        {sections.map((s) => <a href={s.href} aria-current={here.startsWith(s.href) ? 'page' : undefined} class="text-sm font-semibold text-white/85 transition hover:text-white aria-[current=page]:text-white aria-[current=page]:underline aria-[current=page]:underline-offset-8">{s.label}</a>)}
      </nav>
    </div>
    <!-- One search box on every page. On /talks it searches in place; elsewhere it carries the search there. -->
    <form action="/talks" role="search" data-search-form class="relative w-full">
      <label for="search" class="sr-only">Search the talks</label>
      <span aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 z-10 -translate-y-1/2 text-panel-navy/70"><Icon name="Search" size={16} /></span>
      <input id="search" name="q" type="search" autocomplete="off" spellcheck="false" placeholder="Search talks" aria-keyshortcuts="Meta+K Control+K /" class="peer h-10 w-full rounded-full border border-transparent bg-white pl-10 pr-10 font-sans text-base text-panel-navy outline-none transition placeholder:text-panel-navy/60 focus:border-deep-navy focus:ring-2 focus:ring-deep-navy/40 max-md:placeholder-shown:pr-3 md:pr-16 md:text-sm" />
      <kbd aria-hidden="true" data-kbd class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2 rounded-md border border-panel-navy/15 bg-soft-white px-1.5 py-0.5 font-sans text-[11px] font-semibold text-panel-navy/70 peer-focus:hidden peer-[:not(:placeholder-shown)]:hidden md:block">⌘K</kbd>
      <button type="button" data-search-clear aria-label="Clear the search" class="absolute right-2 top-1/2 hidden size-6 -translate-y-1/2 place-items-center rounded-full bg-panel-navy/10 text-panel-navy transition hover:bg-panel-navy/20 peer-[:not(:placeholder-shown)]:grid">
        <svg aria-hidden="true" viewBox="0 0 12 12" class="size-2.5"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
    </form>
    <div class="flex items-center gap-2 justify-self-end">
      <Button variant="inverse-outline" size="sm" href={speak.href} class="max-xl:hidden">{speak.label}</Button>
      <RegisterButton size="sm" class="max-sm:hidden" />
      <details data-nav-menu class="xl:hidden">
        <summary class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full transition hover:bg-white/10 [&::-webkit-details-marker]:hidden">
          <span aria-hidden="true"><Icon name="Menu" size={20} /></span><span class="sr-only">Menu</span>
        </summary>
        <div class="absolute inset-x-0 top-full mt-3 max-h-[calc(100dvh-6rem)] overflow-y-auto overscroll-contain rounded-3xl border border-white/10 bg-deep-navy px-5 pb-6 pt-2 shadow-[0_24px_48px_-16px_rgb(5_7_30/0.6)]">
          <nav aria-label="Sections" class="grid">
            {sections.map((s) => <a href={s.href} aria-current={here.startsWith(s.href) ? 'page' : undefined} class="border-b border-white/10 py-4 text-xl font-bold aria-[current=page]:underline aria-[current=page]:underline-offset-8">{s.label}</a>)}
          </nav>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            <Button variant="inverse-outline" href={speak.href}>{speak.label}</Button>
            <RegisterButton />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
<script is:inline>
  {
    // Glass to navy once the page leaves the top.
    const bar = document.querySelector('[data-sticky-nav]');
    const moved = () => bar.toggleAttribute('data-scrolled', scrollY > 8);
    addEventListener('scroll', moved, { passive: true });
    moved();
    // The menu closes once you leave it: a press outside (pointerdown, which iOS sends from
    // anywhere), a link followed, focus moved to something outside, or Escape.
    const menu = document.querySelector('[data-nav-menu]');
    addEventListener('pointerdown', (e) => { if (!menu.contains(e.target)) menu.open = false; });
    menu.addEventListener('click', (e) => { if (e.target.closest('a')) menu.open = false; });
    menu.addEventListener('focusout', (e) => { if (e.relatedTarget && !menu.contains(e.relatedTarget)) menu.open = false; });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary').focus(); } });

    const box = document.getElementById('search');
    const searchPage = location.pathname.replace(/\/$/, '') === '/talks';
    if (!/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelector('[data-kbd]').textContent = 'Ctrl K';
    // Cmd-K always; Ctrl-K and "/" only outside text fields, the search box included
    // (Ctrl-K edits text on macOS, and "/" is a character people search for).
    addEventListener('keydown', (e) => {
      const el = document.activeElement;
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(el?.tagName ?? '') || el?.isContentEditable;
      const plain = !e.metaKey && !e.ctrlKey && !e.altKey;
      if ((e.key === '/' && plain && !typing) || (e.key === 'k' && (e.metaKey || (e.ctrlKey && !typing)))) {
        e.preventDefault();
        if (searchPage) { box.focus(); box.select(); } else location.href = '/talks?focus';
      }
    });
    // Off /talks, the search lives on /talks: clicking the box, or typing in it,
    // goes there. Tabbing through the nav doesn't.
    if (!searchPage) {
      box.addEventListener('pointerdown', (e) => { e.preventDefault(); location.href = '/talks?focus'; });
      box.addEventListener('keydown', (e) => {
        if (e.key.length !== 1 || e.metaKey || e.ctrlKey || e.altKey || e.isComposing) return;
        e.preventDefault();
        location.href = `/talks?q=${encodeURIComponent(box.value + e.key)}`;
      });
      box.addEventListener('compositionend', () => { location.href = `/talks?q=${encodeURIComponent(box.value)}`; });
    }
    document.querySelector('[data-search-clear]').addEventListener('click', () => {
      box.value = '';
      box.dispatchEvent(new Event('input', { bubbles: true }));
      box.focus();
    });
  }
</script>
<script is:inline define:vars={{ starts, luma }}>
  // The site is rebuilt only on deploy: once the next event has started, every
  // register link points to the Luma calendar, and the heroes' next meetup gives way.
  if (starts && Date.parse(starts) + 4 * 3600e3 < Date.now()) {
    addEventListener('DOMContentLoaded', () => {
      for (const a of document.querySelectorAll('a.js-register')) {
        a.href = luma;
        a.textContent = 'Follow on Luma';
      }
      // NextMeetup renders both states; this shows the second.
      for (const card of document.querySelectorAll('[data-next-event]')) {
        card.hidden = true;
        card.nextElementSibling?.removeAttribute('hidden');
      }
    });
  }
</script>
