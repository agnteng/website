---
// One meetup. Before it happens: the date, the venue and the way to register on Luma.
// Afterwards: its talks, photos and Q&A.
import { Image } from 'astro:assets';
import Shell from '../../layouts/Shell.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TalkTile from '../../components/TalkTile.astro';
import SpeakerCard from '../../components/SpeakerCard.astro';
import Gallery from '../../components/Gallery.astro';
import Artifacts from '@agnteng/brand/components/Artifacts.tsx';
import BlueTone from '../../components/BlueTone.astro';
import Button from '@agnteng/brand/components/Button.astro';
import Icon from '@agnteng/brand/components/Icon.astro';
import { events, past, nextEvent, talks as allTalks, talksAt, questionsAt, photosAt, coverAt, isUpcoming, longDate, shortDate, eventSlug, eventName, eventSummary, links, type Event } from '../../lib/data';
import { eventNode, breadcrumbs } from '../../lib/schema';

export function getStaticPaths() {
  return events.map((event) => ({ params: { slug: eventSlug(event) }, props: { event } }));
}
const { event: e } = Astro.props as { event: Event };
const upcoming = isUpcoming(e);
const talks = talksAt(e);
const questions = questionsAt(e);
const photos = photosAt(e);
// A meetup that hasn't happened has no photos: it borrows the last one's.
const cover = coverAt(e) ?? (upcoming && past[0] ? coverAt(past[0]) : undefined);
const luma = e.luma?.url ?? links.luma;
const speakers = upcoming ? (e.speakers ?? []).map((s) => ({ slug: '', ...s, href: luma })) : [];
// The cells that hide the cover's leading edge; each night has its own pattern.
const cells = { color: '#1E2BE6', seed: Number(e.date.replaceAll('-', '')), cell: 10, animate: true } as const;
---
<Shell title={`Agentic Engineering ${eventName(e)}, ${shortDate(e.date)}`} description={eventSummary(e)} schema={[eventNode(e), breadcrumbs(['Events', '/events'], [eventName(e), `/events/${eventSlug(e)}`])]} class="bg-soft-white text-panel-navy">
  <BlueTone />
  <section class="relative isolate overflow-hidden bg-electric-blue text-white">
    <SiteNav onHero />
    <div class="relative z-10 mx-auto max-w-7xl px-4 pt-14 pb-10 md:px-8 md:pt-20 md:pb-28">
      <h1 class="rise font-sans text-5xl font-extrabold tracking-tight md:max-w-[40%] md:text-6xl">{eventName(e)}</h1>
      <p class="rise mt-6 flex items-center gap-2.5 font-sans text-sm font-medium md:max-w-[40%]" style="--i:1"><Icon name="Calendar" size={16} class="shrink-0 text-periwinkle" />{longDate(e.date)}{upcoming && ` · ${e.venue}`}</p>
      <div class="rise mt-8 flex flex-wrap gap-3" style="--i:2">
        {upcoming
          ? <Button href={luma} class={`${e === nextEvent ? 'js-register ' : ''}!bg-white !text-electric-blue`}>{e.free ? 'Register – Free' : 'Register'}</Button>
          : <>
              {e.recap && <Button href={e.recap} class="!bg-white !text-electric-blue">Read the recap</Button>}
              <Button variant="outline" href={links.luma} class={e.recap ? '!border-white/45 !text-white hover:!border-white' : '!border-white !bg-white !text-electric-blue'}>See upcoming events</Button>
            </>}
      </div>
    </div>
    {cover && (
      <div class="dither-stage relative h-72 w-full overflow-hidden md:absolute md:inset-y-0 md:right-0 md:h-auto md:w-[64%]" aria-hidden="true">
        <Image src={cover.img} alt="" widths={[960, 1600]} sizes="(min-width: 768px) 64vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 size-full object-cover [filter:url(#blue-tone)]" />
        <div class="absolute inset-0 max-md:hidden"><Artifacts client:load {...cells} artifacts={[{ at: 'left', solid: 0.2, reach: 0.52 }]} /></div>
        <div class="absolute inset-0 md:hidden"><Artifacts client:load {...cells} artifacts={[{ at: 'top', solid: 0.1, reach: 0.45 }]} /></div>
      </div>
    )}
  </section>

  <main id="main" class="mx-auto max-w-7xl px-4 md:px-8">
    {upcoming && (
      <section class="py-16 md:py-24">
        <div class="grid gap-10 md:grid-cols-12">
          <h2 class="font-sans text-3xl font-extrabold tracking-tight md:col-span-4 md:text-4xl">The meetup</h2>
          <div class="space-y-5 text-lg md:col-span-8">
            <p>People show what they’ve shipped with agents: ten-minute talks, then open questions. In {e.city}, in English.</p>
            <p>To speak, register and describe your talk in the talk field. Ten minutes, real work, no pitches.</p>
          </div>
        </div>
      </section>
    )}

    {speakers.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] py-16 md:py-24">
        <h2 class="font-sans text-3xl font-extrabold tracking-tight md:text-4xl">Speakers</h2>
        <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">{speakers.map((s, i) => <li><SpeakerCard speaker={s} index={i} /></li>)}</ul>
      </section>
    )}

    {talks.length > 0 && (
      <section class="py-16 md:py-24">
        <h2 class="font-sans text-3xl font-extrabold tracking-tight md:text-4xl">Talks</h2>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{talks.map((t, i) => <li class="reveal"><TalkTile talk={t} index={i} summary /></li>)}</ul>
      </section>
    )}

    {upcoming && (
      <section class="border-t border-panel-navy/[0.08] py-16 md:py-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="font-sans text-3xl font-extrabold tracking-tight md:text-4xl">Latest talks</h2>
          <Button variant="outline" href="/talks">All talks</Button>
        </div>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{allTalks.slice(0, 3).map((t, i) => <li class="reveal"><TalkTile talk={t} index={i} /></li>)}</ul>
      </section>
    )}

    {photos.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] pb-16 md:pb-24">
        <Gallery photos={photos} />
      </section>
    )}

    {questions.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] py-16 md:py-24">
        <div class="grid gap-10 md:grid-cols-12">
          <h2 class="font-sans text-3xl font-extrabold tracking-tight md:col-span-4 md:text-4xl">Q&A</h2>
          <div class="divide-y divide-panel-navy/10 md:col-span-8">
            {questions.map((q) => (
              <details class="group py-1">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4 font-sans text-lg font-bold leading-snug [&::-webkit-details-marker]:hidden">
                  <span>{q.question}</span>
                  <span class="mt-1 font-mono text-sm text-electric-blue transition group-open:rotate-45">+</span>
                </summary>
                <div class="space-y-4 pb-6">
                  {q.answers.map((a) => a.text.split('\n\n').map((para, i) => (
                    <p class="leading-relaxed text-panel-navy/80">{i === 0 && <span class="font-semibold text-panel-navy">{a.speaker}: </span>}{para}</p>
                  )))}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <SiteFooter />
</Shell>
