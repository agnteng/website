---
// One meetup. Before it happens: the date and the way to register on Luma. Afterwards:
// its talks, photos and Q&A. In between, while its talks aren't published, it keeps its
// speakers. Never the venue's name (AGENTS.md). Without photos, the hero shows the dither.
import { Image } from 'astro:assets';
import Shell from '../../layouts/Shell.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TalkTile from '../../components/TalkTile.astro';
import SpeakerCard from '../../components/SpeakerCard.astro';
import Gallery from '../../components/Gallery.astro';
import HeroCells from '../../components/HeroCells.astro';
import Tone from '../../components/Tone.astro';
import Animation from '@agnteng/brand/components/Animation.tsx';
import Button from '@agnteng/brand/components/Button.astro';
import PageTitle from '../../components/PageTitle.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EventDate from '../../components/EventDate.astro';
import RegisterButton from '../../components/RegisterButton.astro';
import { events, nextEvent, talks as allTalks, talksAt, takeawaysAt, questionsAt, photosAt, coverAt, isUpcoming, shortDate, eventSlug, eventName, eventSummary, links, pitchIn, toSpeak, type Event } from '../../lib/data';
import { eventNode, breadcrumbs } from '../../lib/schema';

export function getStaticPaths() {
  return events.map((event) => ({ params: { slug: eventSlug(event) }, props: { event } }));
}
const { event: e } = Astro.props as { event: Event };
const upcoming = isUpcoming(e);
const talks = talksAt(e);
const questions = questionsAt(e);
const takeaways = takeawaysAt(e);
const photos = photosAt(e);
const published = talks.length > 0;
const cover = coverAt(e);
const luma = e.luma?.url ?? links.luma;
const speakers = published ? [] : (e.speakers ?? []).map((s) => ({ slug: '', ...s, href: luma }));
---
<Shell title={`Agentic Engineering ${eventName(e)}, ${shortDate(e.date)}`} description={eventSummary(e)} schema={[eventNode(e), breadcrumbs(['Events', '/events'], [eventName(e), `/events/${eventSlug(e)}`])]} class="bg-soft-white text-panel-navy">
  <Tone />
  <SiteNav onHero />
  <section class="under-nav relative isolate overflow-hidden bg-electric-blue text-white">
    <div class="relative z-10 mx-auto max-w-7xl px-4 pt-14 pb-10 md:px-8 md:pt-20 md:pb-28">
      <PageTitle rise class="md:max-w-[40%]">{eventName(e)}</PageTitle>
      <EventDate date={e.date} variant="hero" class="rise mt-6" style="--i:1" />
      <div class="rise mt-8 flex flex-wrap gap-3" style="--i:2">
        {upcoming
          ? <RegisterButton event={e} />
          : <>
              {e.recap && <Button variant="inverse" href={e.recap}>Read the recap</Button>}
              {nextEvent
                ? <Button variant={e.recap ? 'inverse-outline' : 'inverse'} href={`/events/${eventSlug(nextEvent)}`}>Next meetup</Button>
                : <RegisterButton followLuma secondary={!!e.recap} />}
            </>}
      </div>
    </div>
    <div class="dither-stage relative isolate h-72 w-full overflow-hidden md:absolute md:inset-y-0 md:right-0 md:h-auto md:w-[64%]" aria-hidden="true">
      {cover
        ? <>
            <Image src={cover.img} alt="" widths={[640, 960, 1280, 1600]} quality={60} sizes="(min-width: 768px) 64vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 size-full object-cover [filter:url(#blue-tone)]" />
            <!-- Each night has its own pattern. -->
            <HeroCells seed={Number(e.date.replaceAll('-', ''))} />
          </>
        : <Animation client:load color="#3A4DFF" edge="#B5A6FF" cell={10} density={0.6} fade="left" style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />}
    </div>
  </section>

  <main id="main" class="mx-auto max-w-7xl px-4 md:px-8">
    {upcoming && (
      <section class="py-16 md:py-24">
        <div class="grid gap-10 md:grid-cols-12">
          <SectionHeading class="md:col-span-4">The meetup</SectionHeading>
          <div class="space-y-5 text-lg md:col-span-8">
            <p>{pitchIn(e.city)}</p>
            <p>{toSpeak}</p>
          </div>
        </div>
      </section>
    )}

    {speakers.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] py-16 md:py-24">
        <SectionHeading>Speakers</SectionHeading>
        <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">{speakers.map((s, i) => <li><SpeakerCard speaker={s} index={i} /></li>)}</ul>
      </section>
    )}

    {!upcoming && !published && (
      <section class="py-16 md:py-24">
        <p class="text-lg">The talks from this meetup aren’t published yet.</p>
      </section>
    )}

    {published && (
      <section class="py-16 md:py-24">
        <SectionHeading>Talks</SectionHeading>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{talks.map((t, i) => <li class="reveal"><TalkTile talk={t} index={i} summary showEvent={false} /></li>)}</ul>
      </section>
    )}

    {takeaways.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] py-16 md:py-24">
        <SectionHeading>Main takeaways</SectionHeading>
        <ol class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2">
          {takeaways.map((k) => (
            <li class="reveal border-t border-panel-navy/10 pt-6">
              <h3 class="font-sans text-xl font-extrabold leading-snug tracking-tight">{k.title}</h3>
              <p class="mt-3 max-w-[60ch] leading-relaxed text-panel-navy/80">{k.text}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {upcoming && (
      <section class="border-t border-panel-navy/[0.08] py-16 md:py-24">
        <SectionHeading action={{ href: '/talks', label: 'All talks' }}>Latest talks</SectionHeading>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{allTalks.slice(0, 3).map((t, i) => <li class="reveal"><TalkTile talk={t} index={i} /></li>)}</ul>
      </section>
    )}

    {photos.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] py-16 md:py-24">
        <SectionHeading>Photos</SectionHeading>
        <Gallery photos={photos} />
      </section>
    )}

    {questions.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] py-16 md:py-24">
        <div class="grid gap-10 md:grid-cols-12">
          <SectionHeading class="md:col-span-4">Q&A</SectionHeading>
          <div class="divide-y divide-panel-navy/10 md:col-span-8">
            {questions.map((q) => (
              <details class="group py-1">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4 font-sans text-lg font-bold leading-snug [&::-webkit-details-marker]:hidden">
                  <span>{q.question}</span>
                  <span class="mt-1 font-mono text-sm text-electric-blue transition group-open:rotate-45">+</span>
                </summary>
                <div class="space-y-4 pb-6">
                  {q.answers.map((a) => a.text.split('\n\n').map((para, i) => (
                    <p class="leading-relaxed text-panel-navy/80">{i === 0 && <span class="font-semibold text-panel-navy">{a.speaker}: </span>}{para}</p>
                  )))}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <SiteFooter />
</Shell>
