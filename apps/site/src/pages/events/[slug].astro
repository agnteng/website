---
import { Image } from 'astro:assets';
import Shell from '../../layouts/Shell.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TalkTile from '../../components/TalkTile.astro';
import Gallery from '../../components/Gallery.astro';
import Artifacts from '@agnteng/brand/components/Artifacts.tsx';
import BlueTone from '../../components/BlueTone.astro';
import Button from '@agnteng/brand/components/Button.astro';
import Icon from '@agnteng/brand/components/Icon.astro';
import { events, talksAt, questionsAt, photosAt, coverAt, longDate, eventSlug, eventName, links, type Event } from '../../lib/data';

export function getStaticPaths() {
  return events.filter((e) => talksAt(e).length).map((event) => ({ params: { slug: eventSlug(event) }, props: { event } }));
}
const { event: e } = Astro.props as { event: Event };
const talks = talksAt(e);
const questions = questionsAt(e);
const photos = photosAt(e);
const cover = coverAt(e);
// The cells that hide the cover's leading edge; each night has its own pattern.
const cells = { color: '#1E2BE6', seed: e.number * 101 + e.city.length, cell: 10, animate: true } as const;
---
<Shell title={`${eventName(e)}, ${longDate(e.date)} | Agentic Engineering`} description={`Agentic Engineering ${eventName(e)}: ${talks.map((t) => t.title).join(', ')}.`} class="bg-soft-white text-panel-navy">
  <BlueTone />
  <!-- The home hero's treatment: a blue block, the night's cover in its blue, breaking up into it. -->
  <section class="relative isolate overflow-hidden bg-electric-blue text-white">
    <SiteNav onHero />
    <div class="relative z-10 mx-auto max-w-7xl px-4 pt-14 pb-10 md:px-8 md:pt-20 md:pb-28">
      <h1 class="rise font-sans text-5xl font-extrabold tracking-tight md:text-7xl">{eventName(e)}</h1>
      <p class="rise mt-6 flex items-center gap-2.5 font-sans text-sm font-medium" style="--i:1"><Icon name="Calendar" size={16} class="text-periwinkle" />{longDate(e.date)}</p>
    </div>
    {cover && (
      <div class="dither-stage relative h-72 w-full overflow-hidden md:absolute md:inset-y-0 md:right-0 md:h-auto md:w-[64%]" aria-hidden="true">
        <Image src={cover.img} alt="" widths={[960, 1600]} sizes="(min-width: 768px) 64vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 size-full object-cover [filter:url(#blue-tone)]" />
        <div class="absolute inset-0 max-md:hidden"><Artifacts client:load {...cells} artifacts={[{ at: 'left', solid: 0.12, reach: 0.5 }]} /></div>
        <div class="absolute inset-0 md:hidden"><Artifacts client:load {...cells} artifacts={[{ at: 'top', solid: 0.1, reach: 0.45 }]} /></div>
      </div>
    )}
  </section>

  <main id="main" class="mx-auto max-w-7xl px-4 md:px-8">
    <section class="py-16 md:py-24">
      <h2 class="font-sans text-3xl font-extrabold tracking-tight md:text-4xl">Talks</h2>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{talks.map((t, i) => <li class="reveal"><TalkTile talk={t} index={i} /></li>)}</ul>
    </section>

    {photos.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] pb-16 md:pb-24">
        <Gallery photos={photos} />
      </section>
    )}

    {questions.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] py-16 md:py-24">
        <div class="grid gap-10 md:grid-cols-12">
          <h2 class="font-sans text-3xl font-extrabold tracking-tight md:col-span-4 md:text-4xl">Q&A</h2>
          <div class="divide-y divide-panel-navy/10 md:col-span-8">
            {questions.map((q) => (
              <details class="group py-1">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4 font-sans text-lg font-bold leading-snug [&::-webkit-details-marker]:hidden">
                  <span>{q.question}</span>
                  <span class="mt-1 font-mono text-sm text-electric-blue transition group-open:rotate-45">+</span>
                </summary>
                <div class="space-y-4 pb-6">
                  {q.answers.map((a) => a.text.split('\n\n').map((para, i) => (
                    <p class="leading-relaxed text-panel-navy/80">{i === 0 && <span class="font-semibold text-panel-navy">{a.speaker}: </span>}{para}</p>
                  )))}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="flex flex-wrap gap-3 border-t border-panel-navy/[0.08] py-16">
      {e.recap && <Button variant="outline" href={e.recap}>Read the recap</Button>}
      {e.luma && <Button variant="outline" href={e.luma.url}>This event on Luma</Button>}
      <Button variant="primary" href={links.luma}>See upcoming events</Button>
    </section>
  </main>
  <SiteFooter />
</Shell>
