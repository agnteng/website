---
// Every meetup: the ones to come, soonest first, then the ones before.
import Shell from '../../layouts/Shell.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EventTile from '../../components/EventTile.astro';
import Button from '@agnteng/brand/components/Button.astro';
import { events, past, nextEvent, isUpcoming, longDate, eventSlug, eventName, links } from '../../lib/data';
import { eventNode } from '../../lib/schema';

const upcoming = events.filter(isUpcoming).reverse();
const cities = new Intl.ListFormat('en-GB', { type: 'conjunction' }).format([...new Set(events.map((e) => e.city))].sort());
---
<Shell title="Events | Agentic Engineering" description={`Agentic Engineering meetups in ${cities}: the next date, and every previous meetup with its talks, photos and Q&A.`} schema={upcoming.map(eventNode)} class="bg-soft-white text-panel-navy">
  <SiteNav />
  <main id="main" class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-24">
    <h1 class="font-sans text-4xl font-extrabold tracking-tight md:text-6xl">Events</h1>

    {upcoming.map((e) => (
      <section class="mt-12 flex flex-wrap items-center justify-between gap-6 rounded-2xl bg-electric-blue p-8 text-white md:p-10">
        <div>
          <h2 class="font-sans text-3xl font-extrabold tracking-tight md:text-4xl"><a href={`/events/${eventSlug(e)}`} class="hover:underline">{eventName(e)}</a></h2>
          <p class="mt-3 font-sans font-medium">{longDate(e.date)} · {e.venue}</p>
        </div>
        <Button href={e.luma?.url ?? links.luma} class={`${e === nextEvent ? 'js-register ' : ''}!bg-white !text-electric-blue`}>{e.free ? 'Register – Free' : 'Register'}</Button>
      </section>
    ))}

    <h2 class="mt-16 font-sans text-3xl font-extrabold tracking-tight md:mt-24 md:text-4xl">Previous meetups</h2>
    <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:grid-cols-6">
      {past.map((e, i) => <li><EventTile event={e} index={i} /></li>)}
    </ul>
  </main>
  <SiteFooter />
</Shell>
