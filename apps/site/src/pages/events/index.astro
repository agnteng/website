---
// Every meetup as a calendar: the ones to come, soonest first, then the ones before,
// each with its date, its place and the talks given there.
import Shell from '../../layouts/Shell.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TintedPhoto from '../../components/TintedPhoto.astro';
import Button from '@agnteng/brand/components/Button.astro';
import { events, past, nextEvent, isUpcoming, talksAt, coverAt, longDate, shortDate, eventSlug, eventName, links } from '../../lib/data';
import { eventNode } from '../../lib/schema';

const groups = [
  { title: 'Upcoming', events: events.filter(isUpcoming).reverse() },
  { title: 'Previous meetups', events: past },
].filter((g) => g.events.length > 0);
---
<Shell title="AI events in Lisbon | Agentic Engineering" description="Agentic Engineering runs a monthly AI meetup in Lisbon for founders and engineers building with agents. See the next date and every previous meetup with its talks." schema={events.map(eventNode)} class="bg-soft-white text-panel-navy">
  <SiteNav />
  <main id="main" class="mx-auto max-w-5xl px-4 py-16 md:px-8 md:py-24">
    <h1 class="font-sans text-4xl font-extrabold tracking-tight md:text-6xl">AI events in Lisbon</h1>
    <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-panel-navy/80">Agentic Engineering is a monthly AI meetup in Lisbon. People show what they’ve shipped with agents in ten-minute talks, then take open questions. In English.</p>

    {groups.map((group) => (
      <section class="mt-16">
        <h2 class="font-sans text-2xl font-extrabold tracking-tight md:text-3xl">{group.title}</h2>
        <ol class="mt-8 space-y-6">
          {group.events.map((e) => {
            const soon = isUpcoming(e);
            const page = `/events/${eventSlug(e)}`;
            const cover = coverAt(e);
            return (
              <li class="grid gap-x-6 gap-y-3 md:grid-cols-[9rem_1fr]">
                <p class="font-mono text-sm text-panel-navy/65 md:pt-6">
                  <time datetime={e.date} class="block font-sans text-lg font-extrabold text-panel-navy">{shortDate(e.date)}</time>
                  {longDate(e.date).split(',')[0]}
                </p>
                <article class:list={['flex items-start gap-5 rounded-2xl p-5 md:p-6', soon ? 'bg-electric-blue text-white' : 'border border-panel-navy/[0.08] bg-white']}>
                  <div class="min-w-0 flex-1">
                    <p class:list={['font-mono text-xs uppercase tracking-wider', soon ? 'text-white/80' : 'text-electric-blue']}>{e.city} · {e.venue}</p>
                    <h3 class="mt-2 font-sans text-2xl font-extrabold tracking-tight"><a href={page} class="hover:underline">{eventName(e)}</a></h3>
                    {soon
                      ? <>
                          <p class="mt-3 max-w-[52ch] leading-relaxed text-white/90">Ten-minute talks on building with AI agents, then open questions.</p>
                          <div class="mt-5"><Button href={e.luma?.url ?? links.luma} class={`${e === nextEvent ? 'js-register ' : ''}!bg-white !text-electric-blue`}>{e.free ? 'Register – Free' : 'Register'}</Button></div>
                        </>
                      : <ul class="mt-3 space-y-1.5">
                          {talksAt(e).map((t) => (
                            <li class="leading-snug"><a href={`/talks/${t.id}`} class="font-medium hover:text-electric-blue hover:underline">{t.title}</a><span class="max-sm:hidden"> · </span><span class="text-panel-navy/60 max-sm:block">{t.person.name}</span></li>
                          ))}
                        </ul>}
                  </div>
                  {cover && (
                    <a href={page} tabindex="-1" aria-hidden="true" class="hidden w-44 shrink-0 sm:block md:w-52">
                      <TintedPhoto src={cover.img} alt="" sizes="208px" class="aspect-[4/3] rounded-xl" />
                    </a>
                  )}
                </article>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </main>
  <SiteFooter />
</Shell>
