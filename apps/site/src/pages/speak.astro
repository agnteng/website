---
// For people who want to give a talk: what a talk here is, and four past ones, beside the
// form to apply.
import Shell from '../layouts/Shell.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageTitle from '../components/PageTitle.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import PastTalks from '../components/PastTalks.astro';
import { formsOrigin, hostLine, toSpeak } from '../lib/data';
import { organization } from '../lib/schema';

const rules = [
  'Ten minutes, then open questions from the audience.',
  'For a technical audience: the real work, how it works and what you learned.',
  'No product pitch. Talks are chosen on merit, and sponsorship never buys one.',
];
const fields = [
  { id: 'name', label: 'Name', autocomplete: 'name', half: true, error: 'Enter your name.' },
  { id: 'email', label: 'Email', type: 'email', autocomplete: 'email', half: true, error: 'Enter an email address, like name@company.com.' },
  { id: 'company', label: 'Company', autocomplete: 'organization', half: true, error: 'Enter your company’s name.' },
  { id: 'role', label: 'Role', autocomplete: 'organization-title', half: true, error: 'Enter your role.' },
  { id: 'profile', label: 'GitHub or LinkedIn', autocomplete: 'url', inputmode: 'url' as const, autocapitalize: 'off' as const, placeholder: 'github.com/you', 'data-match': '^(https?://)?([\\w-]+\\.)?(github\\.com|linkedin\\.com)/\\S+$', error: 'Enter a link to your GitHub or LinkedIn, like github.com/you.' },
  { id: 'talk', label: 'Your talk', rows: 5, minlength: 30, maxlength: 3000, hint: 'What will you show, and what will people learn? A technical talk on real work, not a product pitch.', error: 'Describe your talk in a few sentences.' },
];
---
<Shell title="Apply to speak | Agentic Engineering" description={`Apply to speak at Agentic Engineering in Lisbon or another European city. ${toSpeak}`} schema={[organization]} class="bg-soft-white text-panel-navy">
  <SiteNav onHero />
  <section class="under-nav relative isolate overflow-hidden bg-electric-blue text-white">
    <div id="main" class="relative z-10 mx-auto grid max-w-7xl gap-10 px-4 pt-14 pb-16 md:grid-cols-12 md:items-center md:gap-8 md:px-8 md:pt-20 md:pb-24">
      <div class="md:col-span-6">
        <PageTitle rise style="--i:0">Show what you’ve built with AI.</PageTitle>
        <p class="rise mt-7 max-w-[44ch] text-lg font-medium leading-relaxed text-white/90" style="--i:1">{hostLine} Each one has three talks by people building with AI.</p>
        <ul class="rise mt-6 max-w-[44ch] space-y-2.5 text-lg leading-relaxed text-white/90" style="--i:2">
          {rules.map((r) => <li class="flex gap-3"><span aria-hidden="true" class="mt-[0.6em] size-2 shrink-0 bg-periwinkle"></span>{r}</li>)}
        </ul>
        <h2 class="rise mt-12 font-sans text-lg font-bold text-white" style="--i:3">Past talks</h2>
        <PastTalks class="rise mt-4 grid-cols-2" style="--i:3" />
      </div>
      <div class="rise md:col-span-6 lg:col-span-5 lg:col-start-8" style="--i:4">
        <EnquiryForm action={`${formsOrigin}/api/speak`} heading="Apply to speak" intro="Tell us who you are and what you’d show. We’ll get back to you by email." fields={fields} submit="Apply to speak" />
      </div>
    </div>
  </section>
  <SiteFooter />
</Shell>
