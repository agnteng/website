---
// Tribe AI's proposal, served only at sponsors.agnteng.com/tribe (docs/adr/0029).
import { Image } from 'astro:assets';
import Shell from '../../layouts/Shell.astro';
import HeroCells from '../../components/HeroCells.astro';
import Tone from '../../components/Tone.astro';
import PageTitle from '../../components/PageTitle.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SubHeading from '../../components/SubHeading.astro';
import CompanyLogos from '../../components/CompanyLogos.astro';
import CommunityFigures from '../../components/CommunityFigures.astro';
import PastTalks from '../../components/PastTalks.astro';
import Animation from '@agnteng/brand/components/Animation.tsx';
import Artifacts from '@agnteng/brand/components/Artifacts.tsx';
import Button from '@agnteng/brand/components/Button.astro';
import SocialIcons from '@agnteng/brand/components/SocialIcons.astro';
import { galleryPhoto, links, still, talks, TINTS, toSpeak } from '../../lib/data';
import tribeLogoWhite from '../../partners/tribe/logo-white.svg';
import lumaShot from '../../partners/tribe/luma.jpg';
import recapShot from '../../partners/tribe/recap.jpg';
import eventShot from '../../partners/tribe/event.jpg';
import meetupPhoto from '../../partners/tribe/meetup.jpg';

const site = 'https://agnteng.com';
const channels = [
  { label: 'agnteng.com', href: site },
  { label: 'Substack', href: links.substack, icon: 'substack' as const },
  { label: 'Luma', href: links.luma, icon: 'luma' as const },
  { label: 'YouTube', href: links.youtube, icon: 'youtube' as const },
];
const tabs = [
  { id: 'who', label: 'Who we are' },
  { id: 'tribe', label: 'Tribe' },
  { id: 'included', label: 'What’s included' },
  { id: 'pricing', label: 'Pricing' },
];

const hero = galleryPhoto('2026-11-11', '15.jpg');
// What Tribe wants from Lisbon, and what the meetups give it.
const goals = [
  { title: 'A presence in Lisbon', body: 'Tribe’s name in front of Lisbon’s developers, engineers and founders, at every meetup and in the recaps and videos that follow it.' },
  { title: 'Access to talent', body: 'Meet engineers who ship AI in production, and get a shortlist of the ones open to new roles after every meetup.' },
  { title: 'A voice in the community', body: 'Tribe’s engineers can apply to speak and share what they’ve learned shipping AI inside the largest companies.' },
];

// What's included. Candidates first, on their own; then brand visibility, each channel a
// picture of it beside what Tribe gets there.
const candidates = [
  'A question on the registration form for people who want to hear from recruiters.',
  'Before each meetup, the list of who registered, so you can reach out, or ask us to.',
  'After each meetup, a shortlist of the strongest candidates for your roles. We go through every participant’s GitHub, LinkedIn and X.',
  'At the end, a report across the six meetups: who came, what they do, and who opted in.',
];
// `shot` is a page, shown in a browser frame; `photo` is a picture of the meetup itself.
type Row = { id: string; title: string; body: string; shot?: ImageMetadata; photo?: ImageMetadata; youtube?: boolean; alt: string };
const visibility: Row[] = [
  {
    id: 'meetup', title: 'At the meetup', photo: meetupPhoto,
    alt: 'The Agentic Engineering Lisbon title slide on the projector, with Tribe AI’s logo under the name',
    body: 'Tribe’s branding at the venue and on the title slide, merch and printed material for attendees, and a slide introducing Tribe at the opening, presented by your team or by us.',
  },
  {
    id: 'luma', title: 'Registration page', shot: lumaShot,
    alt: 'The Luma page for Agentic Engineering Lisbon #6 on 27 January 2027, with an “In partnership with Tribe AI” banner under its first line',
    body: 'An “In partnership with Tribe AI” banner under the first line of each meetup’s Luma page, seen by everyone who registers.',
  },
  {
    id: 'recap', title: 'Newsletter', shot: recapShot,
    alt: 'The Lisbon #6 recap on Substack, with the Tribe AI banner and a “Tribe AI is hiring” block after the introduction',
    body: 'The banner in every meetup’s recap, sent by email and published on Substack, with a “Tribe AI is hiring” block linking to your open roles.',
  },
  {
    id: 'web', title: 'Website', shot: eventShot,
    alt: 'The Lisbon #6 page on agnteng.com, with “In partnership with Tribe AI” and Tribe’s logo under its buttons',
    body: 'Tribe’s logo on each meetup’s page on agnteng.com, where every talk is published with its video and transcript.',
  },
  {
    id: 'youtube', title: 'YouTube', youtube: true,
    alt: 'A talk video on YouTube whose description credits Tribe AI as the meetup’s partner',
    body: 'A partner credit in the description of every talk video from the six meetups.',
  },
];
// The talk the YouTube mockup shows: Harley Alexander's, from PostHog.
const ytTalk = talks.find((t) => t.person.name === 'Harley Alexander' && still(t))!;

const price = { full: 6000, deal: 4500, meetups: 6, single: 1000 };
// The Stripe payment link for the six meetups; the button shows once it is set.
const stripeLink = '';
const usd = (n: number) => `$${n.toLocaleString('en')}`;
---
<Shell noindex title="Agentic Engineering × Tribe AI" description="A partnership proposal for Tribe AI: six Agentic Engineering meetups in Lisbon, from 27 January 2027." class="bg-soft-white text-panel-navy">
  <Tone />

  <!-- The proposal's nav: both logos, and the four parts of the page. -->
  <header data-sticky-nav class="group pointer-events-none sticky top-3 z-50 mx-auto max-w-7xl px-4 text-white md:top-4 md:px-8">
    <div class="pointer-events-auto flex min-h-14 flex-wrap items-center justify-between gap-x-6 gap-y-1 rounded-[28px] border border-white/20 bg-white/12 py-2 pl-5 pr-2 shadow-[0_12px_32px_-12px_rgb(5_7_30/0.35)] backdrop-blur-xl transition-colors duration-300 group-data-[scrolled]:border-white/10 group-data-[scrolled]:bg-deep-navy/85 [@media(scripting:none)]:bg-deep-navy/85">
      <div class="flex h-10 items-center gap-3">
        <img src="/assets/logo/ae-mark-white.svg" width="187" height="160" alt="Agentic Engineering" class="h-6 w-auto" />
        <span aria-hidden="true" class="text-base font-semibold text-white/60">×</span>
        <img src={tribeLogoWhite.src} width={tribeLogoWhite.width} height={tribeLogoWhite.height} alt="Tribe AI" class="h-[18px] w-auto" />
      </div>
      <nav aria-label="Proposal" class="-mx-1 flex max-w-full overflow-x-auto [scrollbar-width:none]">
        {tabs.map((t) => (
          <a href={`#${t.id}`} data-tab={t.id} class="shrink-0 whitespace-nowrap rounded-full px-2.5 py-2 text-[13px] font-semibold sm:px-3.5 sm:text-sm text-white/80 transition-colors hover:text-white aria-[current=true]:bg-white aria-[current=true]:text-electric-blue">{t.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- The pitch on the left; the photo on the right, breaking up into the blue at its left
         edge (at its top on a phone, where it sits below). -->
    <section class="under-nav relative isolate overflow-hidden bg-electric-blue text-white">
      <div class="relative z-10 mx-auto grid max-w-7xl px-4 md:grid-cols-12 md:px-8">
        <div class="pt-14 pb-12 md:col-span-6 md:pt-24 md:pb-28 lg:pt-28 lg:pb-36">
          <PageTitle rise style="--i:0">Engage Lisbon’s AI engineering community.</PageTitle>
          <p class="rise mt-7 max-w-[42ch] text-lg font-medium leading-relaxed text-white/90" style="--i:1">Six monthly meetups from 27 January. Put Tribe in front of the engineers building with AI in Lisbon, and meet the ones you want to hire.</p>
        </div>
      </div>
      <!-- The photo breaks up in a thin band of cells (a thinner HeroCells), its first tenth
           solid, left of centre: the cells may run behind the title. -->
      <div class="dither-stage relative h-72 overflow-hidden md:absolute md:inset-y-0 md:right-0 md:h-auto md:w-[70%]" aria-hidden="true">
        <Image src={hero.img} alt="" widths={[640, 960, 1280, 1600]} quality={60} sizes="(min-width: 768px) 70vw, 100vw" loading="eager" class="absolute inset-0 size-full scale-105 object-cover object-[55%_45%] [filter:url(#blue-tone)_blur(5px)]" />
        <div class="absolute inset-0 z-2 max-md:hidden">
          <Artifacts client:load color="#1E2BE6" edge="#B5A6FF" seed={20270127} cell={10} animate artifacts={[{ at: 'left', solid: 0.1, reach: 0.3, wave: 0.03, waveLength: 0.6 }]} />
        </div>
        <div class="absolute inset-0 z-2 md:hidden">
          <Artifacts client:load color="#1E2BE6" edge="#B5A6FF" seed={20270127} cell={10} animate artifacts={[{ at: 'top', solid: 0.08, reach: 0.3, wave: 0.05, waveLength: 0.7 }]} />
        </div>
        <div class="absolute inset-0 z-3 flex flex-col items-center justify-center gap-4 md:hidden">
          <p class="text-sm font-bold text-white/85">A proposal for</p>
          <img src={tribeLogoWhite.src} width={tribeLogoWhite.width} height={tribeLogoWhite.height} alt="" class="h-12 w-auto drop-shadow-[0_4px_24px_rgb(5_7_30/0.45)]" />
        </div>
      </div>
      <!-- Who the proposal is for, on the photo, aligned with the nav's and the page's right edge. -->
      <div class="pointer-events-none absolute inset-0 z-10 mx-auto flex max-w-7xl flex-col items-end justify-center gap-4 px-4 max-md:hidden md:px-8" aria-hidden="true">
        <p class="text-base font-bold text-white/85">A proposal for</p>
        <img src={tribeLogoWhite.src} width={tribeLogoWhite.width} height={tribeLogoWhite.height} alt="" class="h-16 w-auto drop-shadow-[0_4px_24px_rgb(5_7_30/0.45)] xl:h-24" />
      </div>
    </section>

    <!-- Who we are -->
    <section id="who" data-part class="scroll-mt-24 bg-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 pt-16 md:grid-cols-12 md:gap-8 md:px-8 md:pt-24">
        <SectionHeading class="md:col-span-5">Who we are</SectionHeading>
        <div class="space-y-5 text-lg leading-relaxed md:col-span-7">
          <p class="text-xl font-semibold leading-snug md:text-2xl">Agentic Engineering is for people building software, infrastructure and companies with agentic workflows.</p>
          <p class="text-panel-navy/75">We have run meetups in Lisbon since May 2026, each with three talks, then open questions and drinks. {toSpeak}</p>
          <p class="text-panel-navy/75">Every meetup gets a recap by email and on Substack, and every talk goes on YouTube and <a href={site} class="font-semibold text-panel-navy underline underline-offset-4">agnteng.com</a> with its transcript.</p>
          <ul class="flex flex-wrap gap-3 pt-2">
            {channels.map((c) => (
              <li><a href={c.href} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2.5 rounded-full border-[1.5px] border-panel-navy/15 px-4 py-2.5 text-base font-semibold text-panel-navy transition-colors hover:border-electric-blue hover:text-electric-blue">
                {c.icon ? <SocialIcons name={c.icon} size={18} /> : <span aria-hidden="true" class="inline-block h-4 w-[1.17rem] bg-current [mask:url(/assets/logo/ae-mark.svg)_center/contain_no-repeat]"></span>}
                {c.label}
              </a></li>
            ))}
          </ul>
        </div>
      </div>
      <CommunityFigures class="mx-auto mt-12 max-w-7xl px-4 md:mt-16 md:px-8" />
      <div class="mx-auto mt-12 max-w-7xl px-4 md:mt-16 md:px-8">
        <SubHeading>Past speakers</SubHeading>
        <PastTalks tone="light" base={site} class="mt-6 grid-cols-2 lg:grid-cols-4" />
      </div>
      <CompanyLogos large class="py-14 md:py-20" />
    </section>

    <!-- Tribe -->
    <section id="tribe" data-part class="relative isolate scroll-mt-24 overflow-hidden bg-deep-navy text-soft-white">
      <div class="dither-stage absolute inset-0 -z-10" aria-hidden="true">
        <Animation client:visible animation="aurora" color="#1E2BE6" edge="#B5A6FF" bg="#05071E" cell={6} gap={1} density={0.34} motion={20} fade="left" shape="square" style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', opacity: 0.35 }} />
      </div>
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 md:grid-cols-12 md:gap-8 md:px-8 md:py-24">
        <div class="md:col-span-12">
          <h2 class="sr-only">Tribe AI</h2>
          <img src={tribeLogoWhite.src} width={tribeLogoWhite.width} height={tribeLogoWhite.height} alt="Tribe AI" class="h-9 w-auto md:h-11" />
          <blockquote class="mt-8 max-w-[28ch] text-3xl font-extrabold leading-tight tracking-tight md:text-5xl">“Tribe AI helps the largest companies in the world become AI companies.”</blockquote>
        </div>

        <div class="mt-4 md:col-span-12 md:mt-10">
          <SubHeading as="h3" class="text-white">Why partner with Agentic Engineering</SubHeading>
          <div class="mt-6 grid gap-4 md:grid-cols-3 md:gap-6">
            {goals.map((g) => (
              <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-6 backdrop-blur-sm lg:p-8">
                <h4 class="text-xl font-extrabold">{g.title}</h4>
                <p class="mt-3 leading-relaxed text-soft-white/75">{g.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- What's included -->
    <section id="included" data-part class="scroll-mt-24">
      <div class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-24">
        <SectionHeading>What’s included</SectionHeading>

        <!-- Candidates: a picture of what Tribe receives, without anyone's details. -->
        <div id="candidates" class="mt-12 grid items-center gap-8 md:mt-16 md:grid-cols-12 md:gap-12">
          <div class="md:order-2 md:col-span-7">
            <div class="relative isolate overflow-hidden rounded-2xl bg-electric-blue p-5 text-white md:p-8" aria-hidden="true">
              <div class="dither-stage absolute inset-0 -z-10">
                <Artifacts client:visible color="#05071E" edge="#B5A6FF" seed={2027} cell={12} animate artifacts={[{ at: 'bottom-right', solid: 0.05, reach: 0.4 }]} />
              </div>
              <div class="rounded-xl bg-white p-5 text-panel-navy shadow-[0_12px_40px_-12px_rgb(5_7_30/0.45)] md:p-6">
                <div class="flex items-baseline justify-between gap-4">
                  <p class="text-lg font-extrabold">Shortlist for Tribe AI</p>
                  <p class="text-sm text-panel-navy/60">Lisbon #6 · 27 Jan 2027</p>
                </div>
                <ul class="mt-5 divide-y divide-panel-navy/10">
                  {[
                    ['Senior engineer', 'Agents in production', 'Open to recruiters'],
                    ['Founding engineer', 'Python, LLM tooling', 'Open to recruiters'],
                    ['ML engineer', 'Evals, RAG', 'Open to recruiters'],
                  ].map(([role, work, tag], k) => (
                    <li class="flex items-center gap-4 py-3.5">
                      <span class="size-9 shrink-0 rounded-full" style={`background:${TINTS[k]}`}></span>
                      <span class="min-w-0 flex-1">
                        <span class="block h-2.5 w-28 rounded-full bg-panel-navy/15"></span>
                        <span class="mt-2 block text-sm font-semibold">{role} <span class="font-normal text-panel-navy/60">· {work}</span></span>
                      </span>
                      <span class="hidden shrink-0 rounded-full bg-[#EEF1FF] px-3 py-1 text-xs font-semibold text-electric-blue sm:inline">{tag}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-3 flex gap-2 text-xs text-panel-navy/60"><span>GitHub</span><span>·</span><span>LinkedIn</span><span>·</span><span>X</span></div>
              </div>
            </div>
          </div>
          <div class="md:order-1 md:col-span-5">
            <SubHeading>Candidates</SubHeading>
            <ul class="mt-6 space-y-3 text-lg leading-relaxed text-panel-navy/80">
              {candidates.map((it) => <li class="flex gap-3"><span aria-hidden="true" class="mt-[0.6em] size-2 shrink-0 bg-electric-blue"></span>{it}</li>)}
            </ul>
          </div>
        </div>

        <h3 class="mt-24 border-t border-panel-navy/[0.08] pt-16 font-sans text-2xl font-extrabold leading-tight tracking-tight md:mt-32 md:pt-24 md:text-4xl">Brand visibility</h3>
        <ol class="mt-12 space-y-16 md:mt-16 md:space-y-24">
          {visibility.map((r, i) => (
            <li id={r.id} class="grid items-center gap-8 md:grid-cols-12 md:gap-12">
              <div class:list={['md:col-span-7', i % 2 === 1 && 'md:order-2']}>
                {r.shot
                  ? <div class="overflow-hidden rounded-2xl bg-white shadow-[0_1px_2px_rgb(5_7_30/0.06),0_12px_40px_-12px_rgb(5_7_30/0.25)] ring-1 ring-panel-navy/10">
                      <div class="flex h-8 items-center gap-1.5 border-b border-panel-navy/10 bg-[#F6F7FB] px-3" aria-hidden="true">
                        <span class="size-2.5 rounded-full bg-panel-navy/15"></span><span class="size-2.5 rounded-full bg-panel-navy/15"></span><span class="size-2.5 rounded-full bg-panel-navy/15"></span>
                      </div>
                      <Image src={r.shot} alt={r.alt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 768px) 58vw, 100vw" loading="lazy" class="block h-auto w-full" />
                    </div>
                  : r.youtube
                  ? <div class="overflow-hidden rounded-2xl bg-white shadow-[0_1px_2px_rgb(5_7_30/0.06),0_12px_40px_-12px_rgb(5_7_30/0.25)] ring-1 ring-panel-navy/10">
                      <div class="flex h-8 items-center gap-1.5 border-b border-panel-navy/10 bg-[#F6F7FB] px-3" aria-hidden="true">
                        <span class="size-2.5 rounded-full bg-panel-navy/15"></span><span class="size-2.5 rounded-full bg-panel-navy/15"></span><span class="size-2.5 rounded-full bg-panel-navy/15"></span>
                      </div>
                      <!-- A talk's page on YouTube, drawn here: the video, its title and the description's partner credit. -->
                      <div class="p-4 md:p-6" role="img" aria-label={r.alt}>
                        <div class="relative aspect-video overflow-hidden rounded-xl bg-deep-navy">
                          <Image src={still(ytTalk)!} alt="" widths={[640, 960, 1280]} sizes="(min-width: 768px) 55vw, 100vw" loading="lazy" class="size-full object-cover" />
                        </div>
                        <p class="mt-4 text-lg font-bold leading-snug text-[#0F0F0F]">{ytTalk.title}</p>
                        <div class="mt-3 flex items-center gap-3">
                          <span class="grid size-9 place-items-center rounded-full bg-electric-blue"><img src="/assets/logo/ae-mark-white.svg" width="187" height="160" alt="" class="h-3.5 w-auto" /></span>
                          <span class="text-sm font-semibold text-[#0F0F0F]">Agentic Engineering</span>
                        </div>
                        <div class="mt-4 rounded-xl bg-[#F2F2F2] p-3.5 text-sm leading-relaxed text-[#0F0F0F]">
                          <p class="font-semibold">Recorded at Agentic Engineering Lisbon #6</p>
                          <p class="mt-1">In partnership with <span class="font-semibold">Tribe AI</span>. Tribe is hiring forward deployed engineers: <span class="text-[#065FD4]">tribe.ai/careers</span></p>
                        </div>
                      </div>
                    </div>
                  : <div class="relative aspect-[4/3] overflow-hidden rounded-2xl">
                      <Image src={r.photo!} alt={r.alt} widths={[640, 960, 1280]} sizes="(min-width: 768px) 58vw, 100vw" loading="lazy" class="absolute inset-0 size-full object-cover" />
                    </div>}
              </div>
              <div class:list={['md:col-span-5', i % 2 === 1 && 'md:order-1']}>
                <SubHeading>{r.title}</SubHeading>
                <p class="mt-4 text-lg leading-relaxed text-panel-navy/80">{r.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" data-part class="relative isolate scroll-mt-24 overflow-hidden bg-electric-blue text-white">
      <div class="dither-stage absolute inset-0 -z-10" aria-hidden="true">
        <Artifacts client:visible color="#05071E" edge="#B5A6FF" seed={4500} cell={10} animate artifacts={[{ at: 'bottom', solid: 0.02, reach: 0.2, wave: 0.03, waveLength: 0.5 }]} />
      </div>
      <div class="mx-auto max-w-5xl px-4 py-16 md:px-8 md:py-24">
        <h2 class="sr-only">Pricing</h2>
        <div class="grid overflow-hidden rounded-2xl bg-white text-panel-navy shadow-[0_24px_60px_-20px_rgb(5_7_30/0.6)] md:grid-cols-2">
          <div class="p-6 md:p-10">
            <p class="text-sm font-bold text-electric-blue">Six meetups · Lisbon · 27 January to June 2027</p>
            <p class="mt-6 flex flex-wrap items-baseline gap-x-4">
              <span class="font-sans text-6xl font-extrabold tracking-tight md:text-7xl">{usd(price.deal)}</span>
              <s class="text-2xl font-bold text-panel-navy/40"><span class="sr-only">instead of </span>{usd(price.full)}</s>
            </p>
            <p class="mt-3 font-semibold">Paid upfront. {usd(price.deal / price.meetups)} a meetup instead of {usd(price.single)}.</p>
            <div class="mt-8 flex flex-col gap-3">
              {stripeLink && <Button href={stripeLink} target="_blank" class="w-full">Pay with Stripe</Button>}
              <Button href={`${site}/sponsor`} variant={stripeLink ? 'outline' : 'primary'} class="w-full">Get in touch</Button>
            </div>
          </div>
          <div class="border-t border-panel-navy/10 bg-[#F6F7FB] p-6 md:border-l md:border-t-0 md:p-10">
            <p class="text-sm font-bold text-panel-navy/60">At every meetup</p>
            <ul class="mt-5 space-y-3.5 text-panel-navy/85">
              {['Registrants before, a shortlist of candidates after', 'Branding, merch and an intro slide at the meetup', 'A banner on Luma and in every newsletter', 'Logo on agnteng.com, credit on YouTube', 'The only recruiting partner'].map((l) => (
                <li class="flex gap-3"><span aria-hidden="true" class="mt-[0.55em] size-2 shrink-0 bg-electric-blue"></span>{l}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-deep-navy">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-6 px-4 py-10 md:px-8">
      <a href={site} class="flex items-center gap-2.5">
        <img src="/assets/logo/ae-mark-white.svg" width="187" height="160" alt="" class="h-7 w-auto" />
        <img src="/assets/logo/ae-wordmark-line-white.svg" width="692" height="75" alt="Agentic Engineering" class="h-[18px] w-auto" />
      </a>
      <img src={tribeLogoWhite.src} width={tribeLogoWhite.width} height={tribeLogoWhite.height} alt="Tribe AI" class="h-6 w-auto opacity-80" />
    </div>
  </footer>

  <script>
    // The nav turns navy once the page moves, and marks the part of the page in view.
    const header = document.querySelector('[data-sticky-nav]');
    const onScroll = () => header?.toggleAttribute('data-scrolled', scrollY > 8);
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const seen = new Map<string, number>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) seen.set(e.target.id, e.intersectionRatio);
      const best = [...seen].sort((a, b) => b[1] - a[1])[0];
      for (const a of links) a.setAttribute('aria-current', String(!!best && best[1] > 0 && a.dataset.tab === best[0]));
    }, { threshold: [0, 0.1, 0.25, 0.5, 0.75, 1], rootMargin: '-30% 0px -40% 0px' });
    document.querySelectorAll('[data-part]').forEach((s) => io.observe(s));
  </script>
</Shell>
