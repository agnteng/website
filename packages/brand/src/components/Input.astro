---
// Text input, aligned to DS1: 1.5px border, 10px radius, Manrope. Light-context by default.
// In a form, `name` and any other input attribute (required, autocomplete…) go on the field,
// `hint` is a line under the label, and `error` the message under the field, shown while it
// has aria-invalid="true". `rows` makes it a multi-line field of that height.
// 16px text: iOS zooms into a field set smaller. Label and placeholder pass AA on white.
import type { HTMLAttributes } from 'astro/types';
interface Props extends Omit<HTMLAttributes<'input'>, 'class'> {
  label?: string;
  hint?: string;
  error?: string;
  rows?: number;
  class?: string;
}
const { label, hint, error, rows, type = 'text', id, class: cls, ...attrs } = Astro.props;
const field = id ?? (label ? `field-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` : undefined);
const hintId = hint && field ? `${field}-hint` : undefined;
const errorId = error && field ? `${field}-error` : undefined;
const describedBy = [hintId, errorId].filter(Boolean).join(' ') || undefined;
const look =
  'peer rounded-[10px] border-[1.5px] border-panel-navy/15 bg-white px-3.5 py-3 font-sans text-base text-panel-navy outline-none transition-colors placeholder:text-panel-navy/60 hover:border-panel-navy/30 focus:border-electric-blue aria-[invalid=true]:border-error';
---

<div class={`flex flex-col gap-2 ${cls ?? ''}`}>
  {label && <label for={field} class="font-sans text-sm font-semibold text-panel-navy/80">{label}</label>}
  {hint && <p id={hintId} class="-mt-1 text-sm text-panel-navy/70">{hint}</p>}
  {rows
    ? <textarea id={field} rows={rows} aria-describedby={describedBy} {...(attrs as HTMLAttributes<'textarea'>)} class={`${look} min-h-24 resize-y`} />
    : <input type={type} id={field} aria-describedby={describedBy} {...attrs} class={look} />}
  {errorId && <p id={errorId} class="hidden text-sm font-medium text-error peer-aria-[invalid=true]:block">{error}</p>}
</div>
